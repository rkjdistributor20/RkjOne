# RKJ One - copy to .env.local and fill in values.
# Never commit real secret values.

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database direct connection (optional; current app primarily uses Supabase client keys)
DATABASE_URL=

# Required - Supabase client + server
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional aliases for scripts/tools that expect non-public names.
# Keep these equal to NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY if used.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required - server only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Server-side app secrets (optional unless a feature uses them)
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=

# Portal Ejen - pembayaran online (optional)
# simulate = UAT tanpa gateway (default)
# live = redirect ke gateway (perlukan merchant keys)
SALES_AGENT_PAYMENT_MODE=simulate
SALES_AGENT_PAYMENT_PROVIDER=ipay88
SALES_AGENT_PAYMENT_MERCHANT_ID=
SALES_AGENT_PAYMENT_API_KEY=
SALES_AGENT_PAYMENT_GATEWAY_URL=https://payment.ipay88.com.my/epayment/entry.asp
SALES_AGENT_PAYMENT_WEBHOOK_SECRET=
# Dev/test only: allow unsigned generic webhooks when SALES_AGENT_PAYMENT_MODE=simulate.
# Never enable this in production.
ALLOW_UNSIGNED_PAYMENT_WEBHOOKS=false

# Fiuu Hosted Payment Page untuk Portal Ejen RKJ Distributor sahaja.
# Jangan guna credential Fiuu POS Roti Kaya Junus di sini.
# Kekalkan SALES_AGENT_PAYMENT_MODE=simulate sehingga staging callback + rekonsiliasi lulus.
# SALES_AGENT_PAYMENT_PROVIDER=fiuu
SALES_AGENT_FIUU_ENVIRONMENT=sandbox
SALES_AGENT_FIUU_MERCHANT_ID=
SALES_AGENT_FIUU_VERIFY_KEY=
SALES_AGENT_FIUU_SECRET_KEY=
# Optional official override. Host is restricted to the selected Fiuu environment.
SALES_AGENT_FIUU_PAYMENT_URL=
SALES_AGENT_FIUU_CALLBACK_URL=
SALES_AGENT_FIUU_RETURN_URL=

# Billplz live provider (disyorkan untuk go-live cepat)
# SALES_AGENT_PAYMENT_PROVIDER=billplz
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
# Sandbox: https://www.billplz-sandbox.com/api/v3 | Production: https://www.billplz.com/api/v3
BILLPLZ_API_BASE_URL=https://www.billplz.com/api/v3

# Stripe live provider (optional)
# SALES_AGENT_PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# Resit rasmi - profil syarikat disimpan dalam jadual legal_entities (migration 00080).
# Env di bawah optional override; lalai baca dari database.
RKJ_DIST_COMPANY_ADDRESS=
RKJ_DIST_COMPANY_PHONE=
RKJ_DIST_COMPANY_EMAIL=
RKJ_DIST_SSM=
RKJ_DIST_SST=

# Akaun bank penerima (perlukan untuk FPX live / paparan resit)
RKJ_DIST_BANK_NAME=
RKJ_DIST_BANK_ACCOUNT_NAME=
RKJ_DIST_BANK_ACCOUNT_NO=

# POS DuitNow QR transports are separate and their credentials are not interchangeable:
# manual = static QR + staff confirmation
# fiuu = OPA server-to-server
# fiuu_vt = legacy Fiuu VT App-to-App/deep link
# fiuu_cloudecr = Fiuu VT+ + cloudECR REST API (prepared fallback path)
# Keep "manual" in Production until every BR001 gate and settlement reconciliation passes.
POS_QR_PAYMENT_MODE=manual
# This selector belongs to OPA only; it does not place cloudECR in a sandbox.
POS_FIUU_ENVIRONMENT=sandbox
POS_FIUU_CHANNEL_ID=24
POS_FIUU_QR_VALIDITY_SECONDS=180
# Pemetaan rahsia per cawangan. Simpan di Vercel server env sahaja, bukan dalam fail ini.
# Production requires an explicit provider-approved Store ID and Terminal ID per branch.
POS_FIUU_APPLICATIONS_JSON=
# Pilihan sandbox/pilot sahaja. Production tetap memerlukan pemetaan cawangan lengkap di atas.
POS_FIUU_APPLICATION_CODE=
POS_FIUU_SECRET_KEY=
POS_FIUU_STORE_ID=
POS_FIUU_TERMINAL_ID=
# Optional override rasmi sahaja; lalai dipilih mengikut environment.
POS_FIUU_PRECREATE_URL=

# Legacy Fiuu VT App-to-App only. Do not reuse cloudECR/VT+ identifiers or secrets here.
# The comma-separated allowlist must be explicit. Keep it empty unless testing that legacy path.
POS_FIUU_VT_BRANCHES=
POS_FIUU_VT_VALIDITY_SECONDS=900

# Fiuu VT+ / cloudECR pilot. Keep this entire block unset in Production and keep
# POS_QR_PAYMENT_MODE=manual until a fresh, action-time Production approval.
# A Preview/Staging pilot may allowlist BR001 only. Never include BR002-BR036 before
# BR001 payment, receipt, stock, shift and settlement evidence all pass.
# cloudECR environment separation is by provider-issued account/terminal credentials
# plus deployment scope; the base URL alone is not proof of Sandbox or Production.
# All values are server-only. Never prefix them NEXT_PUBLIC_ or place them in logs.
POS_FIUU_CLOUDECR_BRANCHES=
POS_FIUU_CLOUDECR_BASE_URL=https://cloudecr.fiuu.com
# These identifiers must be the provider-approved BR001 mapping. Do not infer MID/TID,
# reuse another outlet's POS/device/terminal, or mix Sandbox and Production values.
POS_FIUU_CLOUDECR_POS_ID=
POS_FIUU_CLOUDECR_PASSWORD=
POS_FIUU_CLOUDECR_MERCHANT_ID=
POS_FIUU_CLOUDECR_DEVICE_ID=
POS_FIUU_CLOUDECR_TERMINAL_SN=
# Maximum 40 characters; must exactly match Fiuu VT+. This is not a portal password,
# OPA Secret Key, Verify Key, activation QR or binding QR.
POS_FIUU_CLOUDECR_SECRET_KEY=
# Allow the Fiuu interactive transaction window. The hosting route budget must exceed
# this value with margin; otherwise fail UAT and use pending/Get Last recovery.
POS_FIUU_CLOUDECR_TIMEOUT_MS=80000
POS_FIUU_CLOUDECR_VALIDITY_SECONDS=180
RKJ_CAPACITOR_SERVER_URL=https://rkj.one

# Provider POS lama (dikekalkan untuk keserasian rekod sedia ada).
POS_BILLPLZ_API_KEY=
POS_BILLPLZ_COLLECTION_ID=
POS_BILLPLZ_X_SIGNATURE_KEY=
POS_BILLPLZ_API_BASE_URL=https://www.billplz.com/api/v3
POS_BILLPLZ_CUSTOMER_EMAIL=

# Cartrack live GPS - server only, untuk Logistik / Transport RKJ Distributor
# Dapatkan API credential rasmi daripada portal/developer Cartrack.
CARTRACK_API_BASE_URL=https://fleetapi-my.cartrack.com/rest
CARTRACK_API_USERNAME=
CARTRACK_API_TOKEN=
CARTRACK_FLEETWEB_URL=https://fleetweb-my.cartrack.com/map/fleet
