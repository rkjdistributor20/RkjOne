# RKJ One — copy to .env.local and fill in values
# Supabase Dashboard → Project Settings → API

# Required — client + server
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required — server only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App URL — used for auth redirects
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Portal Ejen — pembayaran online (optional)
# simulate = UAT tanpa gateway (default)
# live = redirect ke gateway (perlukan merchant keys)
SALES_AGENT_PAYMENT_MODE=simulate
SALES_AGENT_PAYMENT_PROVIDER=ipay88
SALES_AGENT_PAYMENT_MERCHANT_ID=
SALES_AGENT_PAYMENT_API_KEY=
SALES_AGENT_PAYMENT_GATEWAY_URL=https://payment.ipay88.com.my/epayment/entry.asp
SALES_AGENT_PAYMENT_WEBHOOK_SECRET=

# Billplz live provider (disyorkan untuk go-live cepat)
# SALES_AGENT_PAYMENT_PROVIDER=billplz
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
# Sandbox: https://www.billplz-sandbox.com/api/v3 | Production: https://www.billplz.com/api/v3
BILLPLZ_API_BASE_URL=https://www.billplz.com/api/v3

# Resit rasmi — profil syarikat disimpan dalam jadual legal_entities (migration 00080).
# Env di bawah optional override; lalai baca dari database.
RKJ_DIST_COMPANY_ADDRESS=
RKJ_DIST_COMPANY_PHONE=
RKJ_DIST_COMPANY_EMAIL=
RKJ_DIST_SSM=
RKJ_DIST_SST=
# Akaun bank penerima (perlukan untuk FPX live / paparan resit)
RKJ_DIST_BANK_NAME=
RKJ_DIST_BANK_ACCOUNT_NAME=
RKJ_DIST_BANK_ACCOUNT_NO=

# POS QR verified payment - akaun merchant Roti Kaya Junus (cawangan syarikat)
POS_BILLPLZ_API_KEY=
POS_BILLPLZ_COLLECTION_ID=
POS_BILLPLZ_X_SIGNATURE_KEY=
POS_BILLPLZ_API_BASE_URL=https://www.billplz.com/api/v3
POS_BILLPLZ_CUSTOMER_EMAIL=
